// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String        @unique
  status      StudentStatus @default(VERIFIED)
  enrollments Enrollment[]
  attempts    Attempt[]
  user        User?
}

model Attempt {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId           String           @db.Uuid
  quiz             Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId        String           @db.Uuid
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt        DateTime         @default(now()) @map("started_at")
  submittedAt      DateTime?        @map("submitted_at")
  status           AttemptStatus    @default(IN_PROGRESS)
  attemptAnswers   Json?            @db.JsonB
  score            Decimal?
  questionSnapshot Json?            @db.JsonB
  integrityEvents  IntegrityEvent[]
  answers          Answer[]

  @@unique([quizId, studentId])
  @@index([status, startedAt])
}

model Enrollment {
  quizId    String  @db.Uuid
  studentId String  @db.Uuid
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
}

model Quiz {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  description        String?
  instructions       String?
  createdAt          DateTime      @default(now()) @map("created_at")
  openDate           DateTime      @default(now()) @map("open_date")
  duration           Int           @default(60)
  closesAt           DateTime      @map("close_at")
  passScore          Decimal?      @map("pass_score") @db.Decimal(5, 2)
  status             QuizStatus    @default(DRAFT)
  resultsPolicy      ResultsPolicy @default(AFTER_CLOSE) @map("results_policy")
  questions          Question[]
  enrollments        Enrollment[]
  invitations        Invitation[]
  attempts           Attempt[]
  integrityThreshold Int           @default(5) @map("integrity_threshold")
}

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  password          String
  role              Role          @default(STUDENT)
  status            StudentStatus @default(UNVERIFIED)
  verificationToken String?       @map("verification_token")
  tokenExpiresAt    DateTime?     @map("token_expires_at")
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  /// Links auth identity to quiz-domain Student (null for pure admins).
  studentId         String?       @unique @db.Uuid @map("student_id")
  student           Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  STUDENT
}

model Question {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId       String       @db.Uuid
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String
  explanation  String?      @db.Text
  isHidden     Boolean      @default(false) @map("is_hidden")
  position     Int          @default(0)
  points       Decimal      @default(1) @db.Decimal(7, 2)
  type         QuestionType @default(MCQ)
  deletedAt    DateTime?    @map("deleted_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  options      QuizOption[]
  answers      Answer[]

  @@index([quizId, deletedAt, position])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  OPEN_ENDED
}

model QuizOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     String
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)

  @@index([questionId, position])
}

/// Persistent org-wide taxonomy for the shared question bank (not quiz-scoped).
model QuestionCategory {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now()) @map("created_at")
  questions BankQuestion[]

  @@map("question_categories")
}

/// Reusable bank question. Independent of any quiz; copy into a quiz to use.
model BankQuestion {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String               @db.Uuid @map("category_id")
  category    QuestionCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  text        String
  explanation String?              @db.Text
  type        QuestionType         @default(MCQ)
  points      Decimal              @default(1) @db.Decimal(7, 2)
  deletedAt   DateTime?            @map("deleted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  options     BankQuestionOption[]

  @@index([categoryId, deletedAt])
  @@index([deletedAt, createdAt])
  @@map("bank_questions")
}

model BankQuestionOption {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String       @db.Uuid @map("question_id")
  question   BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     String
  isCorrect  Boolean      @default(false) @map("is_correct")
  position   Int          @default(0)

  @@index([questionId, position])
  @@map("bank_question_options")
}

model Document {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  source     String
  sourceType SourceType
  cohort     String?    @db.VarChar(100)
  metadata   Json?      @db.JsonB
  content    String?    @db.Text
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  chunks Chunk[]

  @@unique([source, title])
  @@map("documents")
}

model Extension {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("extensions")
}

model Chunk {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String                       @db.Uuid
  content         String                       @db.Text
  contentHash     String                       @unique @db.VarChar(64)
  embedding       Json?                        @db.JsonB
  embeddingVector Unsupported("vector(1536)")?
  chunkIndex      Int                          @default(0)
  metadata        Json?                        @db.JsonB

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([contentHash])
  @@index([documentId])
  @@map("chunks")
}

model Answer {
  attemptId        String   @db.Uuid
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String   @db.Uuid
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?  @db.Uuid
  textAnswer       String?  @map("text_answer") @db.Text
  answeredAt       DateTime @default(now()) @map("answered_at")

  @@id([attemptId, questionId])
  @@index([attemptId])
}

model IntegrityEvent {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId  String             @db.Uuid
  attempt    Attempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type       IntegrityEventType @default(VISIBILITY_LOST)
  occurredAt DateTime           @default(now()) @map("occurred_at")

  @@index([attemptId])
}

// NOTE: Slot 3 (Invitations) and Slot 6 (email logs) don't exist in the repo
// yet. These are minimal models to unblock the follow-up dashboard.
model Invitation {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId    String     @db.Uuid
  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  email     String
  invitedAt DateTime   @default(now()) @map("invited_at")
  emailLogs EmailLog[]

  @@index([quizId, email])
}

model EmailLog {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationId String         @db.Uuid
  invitation   Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  status       EmailLogStatus @default(SENT)
  occurredAt   DateTime       @default(now()) @map("occurred_at")
  errorMessage String?        @map("error_message")

  @@index([invitationId])
}

enum EmailLogStatus {
  SENT
  FAILED
}

enum IntegrityEventType {
  VISIBILITY_LOST
}

enum StudentStatus {
  VERIFIED
  UNVERIFIED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResultsPolicy {
  IMMEDIATE
  AFTER_CLOSE
  ADMIN_ONLY
}

enum SourceType {
  FAQ
  ONBOARDING
  SCHEDULE
  PROGRAM_DOC
  OTHER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}
