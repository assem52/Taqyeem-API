# PostgreSQL (pgvector required — Supabase/Neon with vector, or self-hosted with CREATE EXTENSION vector)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/taqyem?schema=public

# Runtime
NODE_ENV=development
PORT=3000

# Auth — required
# openssl rand -hex 32
JWT_SECRET=

# Public frontend origin(s) — required in production (CORS + invite/verify links)
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Admin dual-mode fallback (x-admin-token) — DEV ONLY; disabled when NODE_ENV=production
ADMIN_API_TOKEN=

# Student mock fallback — DEV ONLY; forbidden when NODE_ENV=production
# MOCK_STUDENT_ID=

# Non-production escape code accepted by /auth/verify (emails still get a unique OTP)
# DEV_VERIFICATION_CODE=00000

# Email — leave SMTP_HOST empty for simulated delivery (logs + invite copy-link)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Taqyem <noreply@example.com>"
# EMAIL_DELIVERY_ENABLED=true

# Multi-instance API: set CRON_ENABLED=false on all but one replica
# CRON_ENABLED=true

# RAG / ingestion only
OPENAI_API_KEY=
