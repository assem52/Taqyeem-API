# PostgreSQL (create DB first: createdb qna)
DATABASE_URL=postgresql://USER@localhost:5432/qna?schema=public

# Auth — required (backend will not start without this)
# Generate locally: openssl rand -hex 32
JWT_SECRET=

# Admin dual-mode fallback (x-admin-token). Still useful in DEV.
# Generate: openssl rand -hex 32
# Must match frontend VITE_ADMIN_TOKEN if you use the header fallback.
ADMIN_API_TOKEN=

# Optional student mock fallback (x-student-id). Prefer login instead.
# Matches prisma/seed.ts demo student.
MOCK_STUDENT_ID=11111111-1111-1111-1111-111111111111

# Optional
PORT=3000

# RAG / ingestion modules only
OPENAI_API_KEY=
