# PostgreSQL (create DB first: createdb qna)
DATABASE_URL=postgresql://USER@localhost:5432/qna?schema=public

# Student Quiz Access — mock auth until Slot 1 (matches prisma/seed.ts)
MOCK_STUDENT_ID=11111111-1111-1111-1111-111111111111

# Admin routes — interim shared-secret gate until Slot 1 wires real admin
# role checks (see src/modules/admin-quizzes/guards/admin.guard.ts).
# REQUIRED: admin routes (integrity review, admin follow-up) reject every
# request with 401 if this is unset. Generate a real value per
# environment — do not reuse this file's value or leave it blank in
# production. Example: openssl rand -hex 32
ADMIN_API_TOKEN=

# Optional
PORT=3000

# RAG / ingestion modules only
OPENAI_API_KEY=
